{
  "s01": {
    "duration": 4.336009,
    "cues": [
      {
        "start": 0,
        "end": 1.713333,
        "text": "学中医，懂养生。"
      },
      {
        "start": 1.833333,
        "end": 4.336099,
        "text": "今天一起认识常见的风热证。"
      }
    ]
  },
  "s02": {
    "duration": 9.920998,
    "cues": [
      {
        "start": 0,
        "end": 9.921723,
        "text": "当你出现喉咙肿痛、咳嗽痰黄、鼻涕黄稠，同时身体发热、口渴心烦，这些表现往往会一起出现。"
      }
    ]
  },
  "s03": {
    "duration": 13.052993,
    "cues": [
      {
        "start": 0,
        "end": 5.370431,
        "text": "简单来说，风热证可以理解为风邪与热邪共同影响身体。"
      },
      {
        "start": 5.490431,
        "end": 13.053560000000001,
        "text": "体表不适，肺气宣降受到影响，于是咽喉、呼吸和全身感觉都会发出信号。"
      }
    ]
  },
  "s04": {
    "duration": 16.361995,
    "cues": [
      {
        "start": 0,
        "end": 1.817778,
        "text": "记住三个典型信号。"
      },
      {
        "start": 1.9377779999999998,
        "end": 5.926803,
        "text": "第一，发热口渴，嘴巴发干，心里烦躁。"
      },
      {
        "start": 6.046803,
        "end": 10.999455999999999,
        "text": "第二，喉咙肿痛，咳嗽，痰色偏黄，鼻涕黄稠。"
      },
      {
        "start": 11.119455999999998,
        "end": 16.362357999999997,
        "text": "第三，舌色偏红，舌苔微黄，也可能伴随大便干结。"
      }
    ]
  },
  "s05": {
    "duration": 10.928005,
    "cues": [
      {
        "start": 0,
        "end": 2.443129,
        "text": "调理思路的核心是疏风清热。"
      },
      {
        "start": 2.563129,
        "end": 10.928571,
        "text": "日常可关注桑叶、菊花、薄荷等常见食材，并保持饮食清淡、适量补水和充分休息。"
      }
    ]
  },
  "s06": {
    "duration": 15.853991,
    "cues": [
      {
        "start": 0,
        "end": 2.967166,
        "text": "最后快速总结：病因看风与热；"
      },
      {
        "start": 3.0871660000000003,
        "end": 6.596236,
        "text": "表现看发热、口渴、咽痛和痰黄；"
      },
      {
        "start": 6.716236,
        "end": 8.462767,
        "text": "调理抓住疏风清热；"
      },
      {
        "start": 8.582766999999999,
        "end": 11.604399999999998,
        "text": "生活上注意清淡、补水和通风。"
      },
      {
        "start": 11.724399999999997,
        "end": 15.854467999999997,
        "text": "具体情况请按公司审核内容和专业指导执行。"
      }
    ]
  }
}
