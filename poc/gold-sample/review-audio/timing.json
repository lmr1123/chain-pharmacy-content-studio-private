  "r02": {
    "duration": 22.888005,
    "cues": [
      {
        "start": 0,
        "end": 6.937959,
        "text": "当身体出现喉咙肿痛、咳嗽痰黄、口渴发热时，可以先留意这些信号。"
      },
      {
        "start": 7.057959,
        "end": 13.890657000000001,
        "text": "风与热共同影响身体，往往还会伴随鼻涕黄稠、咽部不适和心里烦躁。"
      },
      {
        "start": 14.010657,
        "end": 18.800589000000002,
        "text": "记住三个关键词：发热、咽喉不适、痰色偏黄。"
      },
      {
        "start": 18.920589000000003,
        "end": 22.888117000000005,
        "text": "具体内容，以公司药师和合规审核稿为准。"
      }
    ]
  }
