      "cues": [
        {
          "start": 0,
          "end": 2.322,
          "text": "就是把身体里的风散出去"
        },
        {
          "start": 2.377,
          "end": 3.882,
          "text": "把热清掉"
        },
        {
          "start": 3.937,
          "end": 6.121,
          "text": "不舒服的感觉自然就缓解了"
        },
        {
          "start": 6.176,
          "end": 7.948,
          "text": "日常生活中有这几样"
        },
        {
          "start": 8.003,
          "end": 9.865,
          "text": "用来调理特别方便"
        },
        {
          "start": 9.92,
          "end": 10.314,
          "text": "记好了"
        },
        {
          "start": 10.369,
          "end": 12.375,
          "text": "一、桑叶"
        },
        {
          "start": 12.43,
          "end": 13.313,
          "text": "能散风热"
        },
        {
          "start": 13.368,
          "end": 14.671,
          "text": "还能滋润肺部"
        },
        {
          "start": 14.726,
          "end": 15.924,
          "text": "缓解咳嗽"
        },
        {
          "start": 15.979,
          "end": 17.616,
          "text": "二、菊花"
        },
        {
          "start": 17.671,
          "end": 19.269,
          "text": "不仅能散风热"
        },
        {
          "start": 19.324,
          "end": 20.825,
          "text": "还能清热解毒"
        },
        {
          "start": 20.88,
          "end": 22.606,
          "text": "平时泡着喝也舒服"
        },
        {
          "start": 22.661,
          "end": 24.157,
          "text": "三、薄荷"
        },
        {
          "start": 24.212,
          "end": 25.926,
          "text": "散风热的效果特别快"
        },
        {
          "start": 25.981,
          "end": 27.462,
          "text": "还能清头目"
        },
        {
          "start": 27.517,
          "end": 28.861,
          "text": "缓解喉咙痛"
        },
        {
          "start": 28.916,
          "end": 30.597,
          "text": "平常在家时"
        },
        {
          "start": 30.652,
          "end": 34.527,
          "text": "用桑叶、菊花、薄荷各3—5克"
        },
        {
          "start": 34.582,
          "end": 36.351,
          "text": "泡一杯水喝"
        },
        {
          "start": 36.406,
          "end": 38.868,
          "text": "就是简单又管用的桑菊薄荷饮"
        },
        {
          "start": 38.923,
          "end": 40.19,
          "text": "喝1—2天"
        },
        {
          "start": 40.245,
          "end": 41.94,
          "text": "就能感觉到舒服不少"
        }
      ]
    },
