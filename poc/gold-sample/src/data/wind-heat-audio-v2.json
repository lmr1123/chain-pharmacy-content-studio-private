      "cues": [
        {
          "start": 0,
          "end": 1.599,
          "text": "它有三个典型信号"
        },
        {
          "start": 1.815,
          "end": 2.858,
          "text": "记好这几点"
        },
        {
          "start": 3.074,
          "end": 4.543,
          "text": "一看就懂"
        },
        {
          "start": 4.759,
          "end": 6.956,
          "text": "一、发热、口渴、嘴巴干"
        },
        {
          "start": 7.172,
          "end": 7.974,
          "text": "心里烦躁"
        },
        {
          "start": 8.19,
          "end": 11.52,
          "text": "二、喉咙肿痛、咳嗽、痰黄"
        },
        {
          "start": 11.737,
          "end": 13.238,
          "text": "流黄稠鼻涕"
        },
        {
          "start": 13.454,
          "end": 15.273,
          "text": "三、舌头偏红"
        },
        {
          "start": 15.49,
          "end": 16.855,
          "text": "舌苔微微发黄"
        },
        {
          "start": 17.071,
          "end": 18.35,
          "text": "大便干结"
        },
        {
          "start": 18.566,
          "end": 20.067,
          "text": "只要你出现这些情况"
        },
        {
          "start": 20.283,
          "end": 22.895,
          "text": "基本就是风热证没跑了"
        },
        {
          "start": 23.112,
          "end": 24.676,
          "text": "对付风热证"
        },
        {
          "start": 24.893,
          "end": 26.034,
          "text": "记住一个核心"
        },
        {
          "start": 26.25,
          "end": 27.5,
          "text": "疏风清热"
        }
      ]
    },
