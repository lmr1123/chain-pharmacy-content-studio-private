      "id": "overview",
      "scene_type": "definition_etiology",
      "section_num": "01",
      "section_title": "疾病概览",
      "badge": "急性上呼吸道感染",
      "definition_parts": [
        { "text": "鼻腔、咽或喉部急性炎症", "emphasize": true },
        { "text": "的概称，是呼吸道最常见的一种传染疾病。\n", "emphasize": false },
        { "text": "本病全年皆可发病，", "emphasize": false },
        { "text": "冬春季节多发", "emphasize": true },
        { "text": "，多为散发，但常在气候突变时流行。", "emphasize": false }
      ],
      "etiology_title": "病因",
      "etiology_parts": [
        { "text": "大约70%是由", "emphasize": false },
        { "text": "病毒", "emphasize": true },
        { "text": "引起，少数由细菌所致。还因淋雨、受凉、气候改变、过度劳累等导致呼吸道防御功能下降，病原体繁殖而诱发本病。", "emphasize": false }
      ]
    },
    {
      "id": "clinical",
      "scene_type": "clinical_blocks",
      "section_num": "02",
      "section_title": "临床表现",
      "blocks": [
        {
          "title": "普通感冒",
          "body": "常见疾病起病，应注意询问有无打喷嚏、鼻塞、流水样鼻涕等鼻咽部卡他症状，有无咽痛、咽痒、声哑等。一般无明显畏寒、高热等全身症状。"
        },
        {
          "title": "病毒性咽炎、喉炎",
          "body": "患者有咽喉部发痒和烧灼感，注意询问有无发热，有无声音嘶哑、讲话困难、咳嗽时疼痛等。"
        },
        {
          "title": "疱疹性咽峡炎",
          "body": "患者有明显的咽痛、发热。"
        }
      ],
      "warning": {
        "label": "询问诱因",
        "body": "有无受凉、淋雨、过度劳累等诱发因素。"
      }
    },
    {
      "id": "exam",
      "scene_type": "exam_two_column",
      "section_num": "03",
      "section_title": "检查方法",
      "left_bullets": [
        "鼻腔粘膜及咽部充血；",
        "可有扁桃体肿大、充血，甚至化脓；有时咽部、扁桃体表面可有灰白色疱疹及浅表溃疡；",
        "病毒感染，实验室检查白细胞正常或偏低；细菌感染，则白细胞升高。"
      ],
      "pathogens": [
        {
          "label": "病毒",
          "body": "鼻病毒、呼吸道合胞病毒、冠状病毒、柯萨奇病毒和腺病毒；"
        },
        {
          "label": "细菌",
          "body": "A族溶血性链球菌、肺炎链球菌、流感嗜血杆菌、葡萄球菌、酿脓链球菌、卡他莫拉菌；"
        },
        {
          "label": "其他",
          "body": "肺炎支原体、衣原体"
        }
      ]
    },
    {
