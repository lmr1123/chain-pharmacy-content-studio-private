  "captions": [
    {
      "start": 0.06,
      "end": 1.243,
      "text": "流感全年可发生"
    },
    {
      "start": 1.243,
      "end": 3.271,
      "text": "冬春高发，夏季也可能高发"
    },
    {
      "start": 3.271,
      "end": 5.299,
      "text": "传染性强，危害大，可致死"
    },
    {
      "start": 5.299,
      "end": 8.171,
      "text": "每年中国流感患病人数可高达1.4亿"
    },
    {
      "start": 8.171,
      "end": 10.875,
      "text": "抗流感药需要抓住黄金48小时用药"
    },
    {
      "start": 11.035,
      "end": 12.446,
      "text": "一、三大核心功效"
    },
    {
      "start": 12.446,
      "end": 13.856,
      "text": "一、专治甲流乙流"
    },
    {
      "start": 14.016,
      "end": 15.852,
      "text": "二、全程一次，一天退热"
    },
    {
      "start": 15.852,
      "end": 17.687,
      "text": "速福达全程只需口服一次"
    },
    {
      "start": 17.687,
      "end": 21.692,
      "text": "且早期阻断病毒复制，遏制新病毒生成，一天快速退热"
    },
    {
      "start": 21.692,
      "end": 24.194,
      "text": "传统药物奥司他韦不阻止病毒复制"
    },
    {
      "start": 24.194,
      "end": 27.531,
      "text": "而是阻止已复制的病毒释放，减少在体内扩散"
    },
    {
      "start": 27.531,
      "end": 29.534,
      "text": "且需一天两次，连续吃五天"
    },
    {
      "start": 29.694,
      "end": 31.706,
      "text": "三、治疗自己，保护身边人"
    },
    {
      "start": 31.706,
      "end": 34.892,
      "text": "仅需患者本人服用，即可早期阻断流感传播"
    },
    {
      "start": 34.892,
      "end": 36.904,
      "text": "大大降低传染给家人的风险"
    },
    {
      "start": 37.064,
      "end": 38.092,
      "text": "二、产品特点"
    },
    {
      "start": 38.092,
      "end": 40.149,
      "text": "一、成人儿童安全性均良好"
    },
    {
      "start": 40.149,
      "end": 42.55,
      "text": "儿童服用呕吐率低，安全性良好"
    },
    {
      "start": 42.71,
      "end": 45.076,
      "text": "二、片剂、干混悬剂双剂型选择"
    },
    {
      "start": 45.076,
      "end": 46.597,
      "text": "片剂无味，药小易吞"
    },
    {
      "start": 46.597,
      "end": 47.95,
      "text": "干混悬剂草莓口味"
    },
    {
      "start": 47.95,
      "end": 51.33,
      "text": "小体重孩子亦可按体重精准给药，服药更轻松"
    },
    {
      "start": 51.49,
      "end": 52.504,
      "text": "三、原研品牌"
    },
    {
      "start": 52.504,
      "end": 56.56,
      "text": "来自第一代流感药奥司他韦厂家——全球制药巨头罗氏"
    },
    {
      "start": 56.56,
      "end": 58.081,
      "text": "70+国家获批上市"
    },
    {
      "start": 58.081,
      "end": 60.277,
      "text": "中国卫健委与WHO一致推荐"
    },
    {
      "start": 60.277,
      "end": 62.305,
      "text": "14项国内外权威指南纳入"
    },
    {
      "start": 62.465,
      "end": 63.459,
      "text": "三、适宜人群"
    },
    {
      "start": 63.459,
      "end": 68.265,
      "text": "5岁及以上既往健康或存在流感并发症高风险的单纯性甲乙流患者"
    },
    {
      "start": 68.425,
      "end": 70.623,
      "text": "特别是：老年人（≥65岁）"
    },
    {
      "start": 70.623,
      "end": 72.653,
      "text": "学龄期儿童（5岁及以上）"
    },
    {
      "start": 72.653,
      "end": 74.851,
      "text": "自身有基础性疾病的慢病患者"
    },
    {
      "start": 75.011,
      "end": 76.011,
      "text": "三、联合用药"
    },
    {
      "start": 76.011,
      "end": 78.846,
      "text": "一、玛巴洛沙韦+退烧药（如布洛芬）"
    },
    {
      "start": 78.846,
      "end": 82.848,
      "text": "在抑制流感病毒复制的同时，快速缓解发热等不适症状"
    },
    {
      "start": 83.008,
      "end": 86.624,
      "text": "二、玛巴洛沙韦+慢病药物（如降压药和降糖药）"
    },
    {
      "start": 86.624,
      "end": 89.748,
      "text": "无需调整剂量，不影响慢病患者的日常管理"
    },
    {
      "start": 89.908,
      "end": 93.513,
      "text": "总结：核心功效 · 产品特点 · 适宜人群 · 联合用药"
    }
