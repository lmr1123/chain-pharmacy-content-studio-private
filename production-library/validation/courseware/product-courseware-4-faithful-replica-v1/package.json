    "export:video:pil": "python3 scripts/export-full-film-video.py",
    "build:stills:pil": "python3 scripts/export-full-film-video.py"
  },
  "dependencies": {
    "@revideo/2d": "0.11.0",
    "@revideo/core": "0.11.0",
    "@revideo/renderer": "0.11.0"
