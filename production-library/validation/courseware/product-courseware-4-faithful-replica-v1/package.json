{
  "name": "product-courseware-4-faithful-replica-v1",
  "private": true,
  "version": "1.0.0",
  "description": "商品培训课件4 保真复刻 · Revideo 可编辑视频（对接项目既有编辑器）",
  "scripts": {
    "start:editor": "bash scripts/run-editor-daemon.sh",
    "start:editor:fg": "node scripts/start-cw4-editor.mjs",
