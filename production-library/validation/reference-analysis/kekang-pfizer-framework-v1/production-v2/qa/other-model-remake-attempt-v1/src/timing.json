    "cues": [
      {
        "id": "K03-S01",
        "text": "失眠常见的表现，包括入睡困难。",
        "start": 0.06,
        "end": 2.799,
        "verb": "难以入睡"
      },
      {
        "id": "K03-S02",
        "text": "夜里可能反复醒来、早醒，醒后难以再次入睡。",
        "start": 2.799,
        "end": 6.633,
        "verb": "反复醒来／早醒"
      },
      {
        "id": "K03-S03",
        "text": "到了第二天，也容易感到疲倦，影响精神状态。",
        "start": 6.633,
        "end": 10.468,
        "verb": "从夜晚累积为次日疲倦"
      }
    ]
  },
  "k13": {
    "duration_seconds": 12.633,
    "audio_duration_seconds": 12.623,
    "cues": [
      {
        "id": "K13-S01",
        "text": "第二项产品特点，是双重提取工艺。",
        "start": 0.06,
        "end": 2.869,
        "verb": "原料进入第一次提取"
      },
      {
        "id": "K13-S02",
        "text": "原料经过第一次提取后，再进入第二次浓缩提取。",
        "start": 2.869,
        "end": 6.732,
        "verb": "提取物转移并浓缩"
      },
      {
        "id": "K13-S03",
        "text": "工艺、专利和吸收相关表述，应与公司批准的证据资料一致。",
        "start": 6.732,
        "end": 11.473,
        "verb": "浓缩完成并受证据约束"
      }
    ]
  }
