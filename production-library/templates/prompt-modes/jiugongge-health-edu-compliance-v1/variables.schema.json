{
  "mode_id": "jiugongge-health-edu-compliance-v1",
  "title": "九宫格合规版（无医疗内容）变量",
  "description": "只谈现象/习惯/常识；禁止医疗身份器材术语",
  "required": ["theme", "audience", "habit_points"],
  "properties": {
    "theme": {
      "type": "string",
      "description": "已脱敏的生活主题"
    },
    "theme_raw": {
      "type": "string",
      "description": "业务原始说法（可含需脱敏词），仅留痕"
    },
    "compliance_transform": {
      "type": "string",
      "description": "如何从医疗红线转到生活习惯/情绪/环境安全"
    },
    "audience": {
      "type": "string",
      "enum": ["中老年", "职场人", "宝妈"]
    },
    "style_key": {
      "type": "string",
      "enum": ["3D动画", "极简扁平", "国风水墨", "治愈水彩"]
    },
    "style_en": {
      "type": "string",
      "description": "写入提示词的英文 Style"
    },
    "habit_points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string" }
    },
    "extra_notes": { "type": "string", "default": "" },
    "aspect_ratio": { "type": "string", "default": "9:16" },
    "xiaolin_outfit_en": { "type": "string" },
    "audience_character": {
      "type": "object",
      "properties": {
        "age_gender_en": { "type": "string" },
        "outfit_en": { "type": "string" }
      }
    },
    "environment_en": { "type": "string" },
    "ending_chinese_text": {
      "type": "string",
      "default": "咱公园见！"
    },
    "publish": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "hashtags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
