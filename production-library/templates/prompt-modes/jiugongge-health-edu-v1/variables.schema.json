{
  "mode_id": "jiugongge-health-edu-v1",
  "title": "九宫格健康科普变量（原版·林医生）",
  "description": "正式 release 所需变量；scaffold 复核阶段可接受残缺输入并将自动扩写标为草稿",
  "required": ["theme", "knowledge_points", "emergency_actions", "prevention_tips"],
  "properties": {
    "theme": {
      "type": "string",
      "description": "科普主题，如：阿尔茨海默病早期筛查"
    },
    "knowledge_points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "string" },
      "description": "正式 release 需 3 条已审核知识点；1～2 条仅生成自动扩写草稿"
    },
    "extra_notes": {
      "type": "string",
      "default": "",
      "description": "补充：更强调急救/预防/家属观察等"
    },
    "aspect_ratio": {
      "type": "string",
      "default": "9:16"
    },
    "segment_seconds": {
      "type": "integer",
      "default": 10,
      "const": 10
    },
    "clinic_scene": {
      "type": "string",
      "default": "温馨明亮的社区诊所卡通诊室，木质桌椅，柔和暖光"
    },
    "emergency_actions": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string" },
      "description": "至少 3 条已审核应急口径；不得使用 scaffold 默认草稿作为正式内容"
    },
    "prevention_tips": {
      "type": "array",
      "minItems": 3,
      "items": { "type": "string" },
      "description": "至少 3 条已审核预防口径；不得使用 scaffold 默认草稿作为正式内容"
    },
    "publish": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "hashtags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
