{
  "mode_id": "jiugongge-health-edu-v1",
  "title": "九宫格健康科普变量（原版·林医生）",
  "description": "填满后写入 00-主题变量.json，再展开六段脚本与提示词",
  "required": ["theme", "knowledge_points"],
  "properties": {
    "theme": {
      "type": "string",
      "description": "科普主题，如：阿尔茨海默病早期筛查"
    },
    "knowledge_points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": { "type": "string" },
      "description": "核心知识点 1～3 条，生活化表述优先"
    },
    "extra_notes": {
      "type": "string",
      "default": "",
      "description": "补充：更强调急救/预防/家属观察等"
    },
    "aspect_ratio": {
      "type": "string",
      "default": "9:16"
    },
    "segment_seconds": {
      "type": "integer",
      "default": 10,
      "const": 10
    },
    "clinic_scene": {
      "type": "string",
      "default": "温馨明亮的社区诊所卡通诊室，木质桌椅，柔和暖光"
    },
    "emergency_actions": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["保持冷静", "立即拨打120", "协助平卧等待救援"]
    },
    "prevention_tips": {
      "type": "array",
      "items": { "type": "string" },
      "default": ["规律作息", "适度活动", "定期体检"]
    },
    "publish": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "body": { "type": "string" },
        "hashtags": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
