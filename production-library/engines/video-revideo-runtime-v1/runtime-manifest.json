{
  "schema": "video-revideo-runtime-manifest-v1",
  "version": "1.0.0",
  "updated": "2026-08-09",
  "purpose": "商品/健康 full MP4 的正式 runtime 入口；业务与 probe 优先解析本引擎，不再把 poc/gold-sample 当作唯一事实源",
  "engine_id": "video-revideo-runtime-v1",
  "kit_rel": "kit",
  "legacy_kit_rel": "poc/gold-sample",
  "required_kit_markers": [
    "package.json",
    "scripts/render-product-segment.mjs",
    "scripts/render-health-segment.mjs",
    "src",
    "node_modules"
  ],
  "entry_scripts": {
    "product_segment": "scripts/render-product-segment.mjs",
    "health_segment": "scripts/render-health-segment.mjs"
  },
  "product_segments": [
    "opening",
    "brand",
    "faithful",
    "efficacy",
    "features",
    "audience",
    "combination",
    "summary"
  ],
  "health_segments": [
    "intro",
    "character",
    "mechanism",
    "symptoms",
    "treatment",
    "medication",
    "summary"
  ],
  "notes_zh": [
    "过渡期 kit 可为指向 poc/gold-sample 的 symlink，正式能力探测与 job 只认 resolve 后的 kit 根。",
    "workspace 由 prepare_workspace 从 kit 复制；node_modules 以 symlink 挂入，避免重复 300MB+ 拷贝。",
    "后续可把 kit 内容整包迁入本目录并去掉 legacy 回退。"
  ]
}
