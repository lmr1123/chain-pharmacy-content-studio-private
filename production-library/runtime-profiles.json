{
  "schema": "runtime-profiles-v1",
  "version": "1.1.0",
  "updated": "2026-08-09",
  "purpose": "按业务能力锁定依赖与探测项；bootstrap/doctor/business_job 共用，避免口头清单漂移",
  "profiles": {
    "pptx": {
      "name_zh": "可编辑 PPT 导出（构件主路径 + 绿色兼容）",
      "require_capabilities": ["pptx_export"],
      "probe_require": ["pptx"],
      "routes": ["product-pptx-component-v1"],
      "legacy_routes": ["product-pptx-green-v1"],
      "default_route": "product-pptx-component-v1",
      "deps": {
        "node": ">=18",
        "python3": ">=3.10",
        "artifact_tool_candidates": [
          "production-library/engines/courseware-pptx-v1/node_modules/@oai/artifact-tool/dist/artifact_tool.mjs",
          "production-library/engines/product-courseware-green-v1/node_modules/@oai/artifact-tool/dist/artifact_tool.mjs",
          "poc/courseware-export/work/node_modules/@oai/artifact-tool/dist/artifact_tool.mjs"
        ],
        "primary_engine_entry": "production-library/engines/courseware-pptx-v1/export.mjs",
        "primary_generator": "scripts/generate_courseware.py",
        "primary_style": "production-library/styles/courseware-4-silk-yellow-red-v1/tokens.json",
        "primary_recipes": "production-library/page-types/product-training/recipes",
        "legacy_engine_entry": "production-library/engines/product-courseware-green-v1/build-product-courseware.mjs",
        "legacy_gold_content_model": "production-library/engines/product-courseware-green-v1/gold-content-model.json"
      },
      "install_hints_zh": [
        "安装 Node.js 18+（Homebrew: brew install node）",
        "确认 Private 生产仓已完整 clone（含 production-library/engines/courseware-pptx-v1 与 page-types）",
        "若缺少 artifact-tool：bootstrap soft-repair 可链接历史 node_modules 到 courseware-pptx-v1 与绿色引擎",
        "默认路线 product-pptx-component-v1；绿色单品为兼容路线",
        "验证：python3 scripts/probe_production_env.py --require pptx && python3 scripts/business_doctor.py --profile pptx"
      ]
    },
    "video-full": {
      "name_zh": "本机完整商品/健康 MP4",
      "require_capabilities": ["video_full"],
      "probe_require": ["video-full"],
      "routes": ["product-mp4-full-v1", "health-mp4-full-v1"],
      "deps": {
        "node": ">=18",
        "ffmpeg": "homebrew 优先 /opt/homebrew/bin/ffmpeg",
        "ffprobe": "与 ffmpeg 同前缀",
        "tts_venv": ".venv-qwen-tts（需可 import mlx_audio.tts）",
        "voice_pack": "production-library/voices/reference-pharmacist-qwen-v1",
        "video_runtime": "production-library/engines/video-revideo-runtime-v1/kit（过渡期可 symlink 到 poc/gold-sample）",
        "video_runtime_module": "scripts/video_runtime.py"
      },
      "install_hints_zh": [
        "安装 ffmpeg/ffprobe（brew install ffmpeg）",
        "按文档准备 .venv-qwen-tts 并验证 from mlx_audio.tts.utils import load_model",
        "确认参考药师 voice pack 完整（manifest + prompt.wav + ref_text）",
        "确认视频 runtime：production-library/engines/video-revideo-runtime-v1/kit 含 render 脚本、src、node_modules（bootstrap 可 soft-repair 链接历史 poc 路径）",
        "验证：python3 scripts/business_doctor.py --profile video-full"
      ]
    },
    "optional-external": {
      "name_zh": "外部付费能力（数字人 / Seedance 等）",
      "require_capabilities": [],
      "probe_require": [],
      "routes": [],
      "deps": {
        "note": "不作为 clean-clone 默认能力；需显式账号与费用审批"
      },
      "install_hints_zh": [
        "默认不安装；业务任务若路由到外部能力，必须先费用与账号确认",
        "当前 active business routes 不依赖本 profile"
      ]
    }
  },
  "route_to_profile": {
    "product-pptx-component-v1": "pptx",
    "product-pptx-green-v1": "pptx",
    "product-mp4-full-v1": "video-full",
    "health-mp4-full-v1": "video-full",
    "courseware3-pptx-mp4-v1": "pptx",
    "gold-preview-only": null
  }
}
